# Copy this file to .env and fill in real local values.
# NEVER commit the actual .env file — it is already listed in .gitignore.

# --- Flask ---
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me

# --- Database (local MySQL) ---
# The database itself (polychem_automation) must already exist locally —
# see README.md "MySQL setup". This backend never connects to the CRM's
# database and never creates cross-database foreign keys.
DATABASE_URL=mysql+pymysql://USERNAME:PASSWORD@localhost:3306/polychem_automation

# --- CORS ---
# Comma-separated list of allowed origins. Never use '*'.
CORS_ORIGINS=http://localhost:3000

# --- Rate limiting ---
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=200 per minute
# Dedicated, stricter limit for POST /api/auth/login (SECURITY.md §2).
LOGIN_RATE_LIMIT=5 per minute

# --- Authentication (Phase 3) ---
# Secret used to sign JWT access tokens. NEVER reuse SECRET_KEY for this,
# and never commit a real value.
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
# Opaque refresh tokens (not JWTs) are stored server-side as a hash in
# refresh_tokens; this is only their lifetime.
REFRESH_TOKEN_EXPIRES_DAYS=14
# Refresh cookie's Secure flag. MUST be true in production (HTTPS only).
# false is only acceptable for local plain-HTTP dev, per SECURITY.md §5.
REFRESH_TOKEN_COOKIE_SECURE=false

# --- Testing (optional override; defaults to an in-memory SQLite DB) ---
# TEST_DATABASE_URL=sqlite:///:memory:

# --- Supplier file uploads ---
# Folder where catalog/datasheet files are stored (default: ./uploads next to run.py).
# UPLOAD_DIR=/var/polychem/uploads
MAX_UPLOAD_MB=10
